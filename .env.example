# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Токен STRATZ (нужен для средних по рангу и точных позиций): https://stratz.com/api
STRATZ_TOKEN=

# Твой Telegram ID (владелец паков эмодзи героев/предметов/рангов; бот пишет его в лог при /start)
OWNER_ID=

# Ключ OpenDota (необязательно, повышает лимиты): https://www.opendota.com/api-keys
OPENDOTA_API_KEY=

# Интервалы проверки новых матчей, сек (активный игрок / давно не играл)
POLL_ACTIVE=180
POLL_IDLE=600
# Сколько минут ждать разбора матча
PARSE_WAIT_MIN=25
# Примерный шаг MMR за рейтинговую игру
MMR_STEP=25
# Иконки на кнопках (премиум-эмодзи, нужен Telegram Premium у владельца бота); 0 - выключить
BUTTON_ICONS=1
# Адрес мини-приложения со статистикой (см. DEPLOY.md); пусто - кнопки «Статистика» нет
WEBAPP_URL=
